# Copy to .env.local and fill in. Never commit .env.local (.gitignore covers .env*).

# --- Supabase (local: `npx supabase status -o env`; hosted: Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key. Safe in the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=


# --- Email (Resend, from your own verified domain). Empty = emails are logged, not sent. ---
RESEND_API_KEY=
EMAIL_FROM=
# Where takedown notices go.
ADMIN_EMAIL=

# --- Google sign-in (your own OAuth client; see replica-watermark/backend.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Jobs ---
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# --- Development only ---
# 1 = /account shows a plan switcher that skips payment. Ignored in production builds.

# Server worker (npm run worker). Exports render on a server with ffmpeg (MP4 with audio).
# WORKER_SECRET: 32+ random characters, the same in the app and every worker (openssl rand -hex 32).
WORKER_SECRET=
# Where the worker reaches the app.
APP_URL=
# "server" = exports go to the worker; leave empty to render exports in the browser tab.
NEXT_PUBLIC_EXPORT_WORKER=
# Optional: WORKER_ID, WORKER_HEALTH_PORT (default 5399), FFMPEG_PATH (default: the bundled ffmpeg-static)
# Optional: cap uploads below the plans' limits, in MB (Supabase's free plan stores files up to 50 MB).
NEXT_PUBLIC_MAX_UPLOAD_MB=

# Video storage. Leave empty to use Supabase Storage (local default).
# "s3" = an S3-compatible store; online this is Cloudflare R2 (free 10 GB, files up to 5 GB).
STORAGE_PROVIDER=
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2: auto
S3_REGION=
S3_BUCKET=
# From an R2 API token with Object Read & Write on that bucket only.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Passcode for the whole site. Set it (as a Secret) to require it before anything opens;
# leave empty to keep the site open (local development, tests).
SITE_PASSCODE=

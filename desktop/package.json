{
  "name": "cleanup-desktop",
  "productName": "Cleanup",
  "version": "0.1.0",
  "description": "Cleanup for Mac: opens your local copy when it's running, otherwise cleanup.dbdd.in.",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.mjs",
    "dist": "electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "in.dbdd.cleanup",
    "productName": "Cleanup",
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Cleanup"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}
